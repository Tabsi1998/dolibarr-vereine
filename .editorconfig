# Dolibarr's conventions: tabs in PHP, LF everywhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = tab
indent_size = 4

[*.{py,yml,yaml,json,md,sh}]
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
